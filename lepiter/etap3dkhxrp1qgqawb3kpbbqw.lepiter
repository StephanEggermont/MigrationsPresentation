					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "eAerQgruDQCEh7r3Bhk5+g=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "When a (public) tender is involved, a loose-loose situation is created where there are incentives created to not be transparent about work that needs to be done but is not obvious to one or more of the parties involved."
			}
