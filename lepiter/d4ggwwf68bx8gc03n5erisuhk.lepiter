						"dateAndTimeString" : "2026-07-19T13:00:49.41664+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-19T13:05:07.942377+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "xbxoIBLGSaOmZTvC4DVr7w=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Migration is of course not the only possible solution to deal with (parts of) legacy systems. There are a number of variants to deal with different problems"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-19T13:01:50.239998+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-19T13:03:02.21071+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "WWOQJXz0TbaYLqZ0qj/rhw=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "###Rehost\nIf the system is fine but runs on hardware that is no longer wanted/supported, rehosting on other hardware or migrate to cloud is a possibility"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-19T13:03:15.235707+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-19T13:46:47.159793+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "cla22nBqRa+6l21ImIMTAg=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "###Replatform\nIf the operating system is getting retired, running the system on a different platform is a possibility"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-19T13:04:03.82453+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-19T13:47:10.819075+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "Vfp4e2+sRiqzKBgWLqHCQQ=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "###Refactor\nKeeping the behavior of the system the same, but removing technical debt and duplication, and making the system more testable and easier to understand and learn"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-19T13:06:10.640395+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-07-19T13:07:55.789372+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "5YGwTjHiQ4GZ21nEIgWi1Q=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "###Retire\nThe best way to lower costs can be to simply retire the system. Organizations grow by buying or merging with other organizations, and that often results in duplication of functionality. "
			}
		]
