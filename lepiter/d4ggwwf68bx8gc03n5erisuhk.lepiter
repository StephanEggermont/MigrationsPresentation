				},
				"string" : "Index: [[Migrations, a working approach]]  Back: [[Priorities]]"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
