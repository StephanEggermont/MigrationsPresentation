					"uidString" : "qBQSiAjyDQCCUzZ3ABjsqQ=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "First do a [[One team skills matrix workshop]]. To do that then for all relevant teams, show the results of the first team to the others to help them get started. "
			},
