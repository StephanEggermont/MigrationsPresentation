				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Determining which skills are sufficiently available, where there are bottlenecks, and where there are skills missing is crucial. This is best done mostly bottom up. "
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
